---
// Shared SVG definitions for the project folders (gradients + highlight blur), declared once per page.
---

<svg class="folder-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <!-- back panel: darker brand red, deeper at the bottom -->
    <linearGradient id="fd-back" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9c2d27" />
      <stop offset="0.3" stop-color="#7a211c" />
      <stop offset="1" stop-color="#3d0f0c" />
    </linearGradient>
    <!-- front panel: glossy brand red (#B23730), lighter top-left, deep red at the bottom -->
    <linearGradient id="fd-front" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e0645a" />
      <stop offset="0.3" stop-color="#b23730" />
      <stop offset="0.75" stop-color="#7f221d" />
      <stop offset="1" stop-color="#4f120f" />
    </linearGradient>
    <radialGradient id="fd-sheen" cx="0.3" cy="0.35" r="0.65">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.2" />
      <stop offset="0.6" stop-color="#ffffff" stop-opacity="0.03" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <!-- chrome rim: bright on the left/top, fading to the right -->
    <linearGradient id="fd-rim" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.95" />
      <stop offset="0.45" stop-color="#ffffff" stop-opacity="0.75" />
      <stop offset="0.75" stop-color="#ffffff" stop-opacity="0.25" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0.6" />
    </linearGradient>
    <linearGradient id="fd-side" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.8" />
      <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.12" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0.35" />
    </linearGradient>
    <filter id="fd-glow" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="0.6" />
    </filter>
  </defs>
</svg>

---
// A project as a folder: the cover peeks out of a red folder, and rises on hover.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const p = project.data;
// a slightly different resting angle per card, so the row doesn't look stamped
const tilt = [-2.2, 1.4, -0.8, 2, -1.6, 0.9][index % 6];
---

<a class="folder" href={`/work/${project.id}/`} data-reveal data-card style={`--tilt: ${tilt}deg`}>
  <span class="folder__back" aria-hidden="true"></span>
  <span class="folder__paper">
    <Image
      src={p.cover}
      alt={p.coverAlt}
      widths={[480, 720, 1080]}
      sizes="(max-width: 700px) 86vw, (max-width: 1100px) 42vw, 28vw"
      loading={index < 3 ? 'eager' : 'lazy'}
      data-card-img
    />
    {p.loop && <video data-card-loop src={p.loop} muted loop playsinline preload="none" aria-hidden="true"></video>}
  </span>
  <span class="folder__front">
    <span class="folder__num mono">{String(index + 1).padStart(3, '0')}</span>
    <span class="folder__label">
      <span class="folder__title">{p.title}</span>
      <span class="folder__cat mono">{p.category}{p.year ? ` · ${p.year}` : ''}</span>
    </span>
  </span>
</a>

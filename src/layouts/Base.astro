---
import '@fontsource/frank-ruhl-libre/400.css';
import '@fontsource/frank-ruhl-libre/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import serif400 from '@fontsource/frank-ruhl-libre/files/frank-ruhl-libre-latin-400-normal.woff2?url';
import serif500 from '@fontsource/frank-ruhl-libre/files/frank-ruhl-libre-latin-500-normal.woff2?url';
import mono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy, altPath, ui, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  current?: 'home' | 'work';
  lang?: Lang;
}

const { lang = 'en', current = 'home' } = Astro.props;
const { site } = copy(lang);
const { title = site.title, description = site.description, image = '/og-image.jpg' } = Astro.props;
const alt = altPath(lang, Astro.url.pathname);
const enPath = lang === 'en' ? Astro.url.pathname : alt;
const esPath = lang === 'es' ? Astro.url.pathname : alt;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site)} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="preload" href={serif400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono400} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@LautaroVolcan" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{ui[lang].skip}</a>
    <Header current={current} lang={lang} alt={alt} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

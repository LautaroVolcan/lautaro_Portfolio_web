---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Label from '../components/Label.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FolderDefs from '../components/FolderDefs.astro';
import { getProjects } from '../lib';
import { site, about, work, education, capabilities } from '../data/site';

const projects = await getProjects();
---

<Base>
  <Hero />

  <section class="section" id="work" aria-labelledby="work-title" data-fluid>
    <div class="wrap">
      <Label n={1} text="Selected work" />
      <h2 class="section__title" id="work-title">Work</h2>
      <FolderDefs />
      <div class="works">
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <Label n={2} text="About" />
      <h2 class="section__title" id="about-title">About me</h2>
      <div class="about">
        <p class="about__lead" data-reveal>{about.lead}</p>
        <div class="about__body" data-reveal>
          {about.body.map((p) => <p>{p}</p>)}
          <div class="about__actions">
            <a class="btn btn--red" href="#contact">Hire me</a>
            <a class="btn" href={site.cv} target="_blank" rel="noopener">Download CV</a>
          </div>
        </div>
      </div>

      <div class="timeline-wrap">
        <div class="timeline" data-reveal>
          <h3 class="meta">Work</h3>
          <ol>
            {work.map((w) => (
              <li>
                <span class="when mono">{w.when}</span>
                <h4>{w.org}</h4>
                <p class="role mono">{w.role}</p>
                <p>{w.text}</p>
              </li>
            ))}
          </ol>
        </div>
        <div class="timeline" data-reveal>
          <h3 class="meta">Education</h3>
          <ol>
            {education.map((w) => (
              <li>
                <span class="when mono">{w.when}</span>
                <h4>{w.org}</h4>
                <p class="role mono">{w.role}</p>
                <p>{w.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="capabilities" aria-labelledby="caps-title">
    <div class="wrap">
      <Label n={3} text="Capabilities" />
      <h2 class="section__title" id="caps-title">{capabilities.intro}</h2>
      <div class="caps">
        {capabilities.items.map((c, i) => (
          <article class="cap" data-reveal>
            <span class="meta">{String(i + 1).padStart(2, '0')}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <Label n={4} text="Get in touch" />
      <h2 class="sr-only" id="contact-title">Contact</h2>
      <a class="contact__big" href={`mailto:${site.email}?subject=Hi%20Lautaro`}>Hi there!</a>
      <div class="contact__row">
        <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="copy-btn mono" type="button" data-copy={site.email}>Copy email</button>
      </div>
      <ul class="socials mono">
        {site.socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label} ↗</a></li>)}
      </ul>
    </div>
  </section>
</Base>

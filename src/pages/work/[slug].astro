---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Label from '../../components/Label.astro';
import { getProjects, embedUrl } from '../../lib';
import { sections } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => {
    // number and "next project" run inside the project's own section (Art, Films, Commercial)
    const same = projects.filter((q) => q.data.section === project.data.section);
    const i = same.indexOf(project);
    return {
      params: { slug: project.id },
      props: { project, index: i, next: same.length > 1 ? same[(i + 1) % same.length] : null },
    };
  });
}

const { project, index, next } = Astro.props;
const p = project.data;
const section = sections.find((s) => s.id === p.section)!;
const cs = p.caseStudy;
const kindLabel = { client: 'Client project', spec: 'Spec work', pitch: 'Pitch', concept: 'Concept' } as const;
const { Content } = await render(project);
const embed = p.video ? embedUrl(p.video) : null;
const og = await getImage({ src: p.cover, width: 1200, format: 'jpg', quality: 82 });

const facts = [
  ['Category', p.category],
  ['Year', p.year],
  ['Client', p.client],
  ['Type', cs ? kindLabel[cs.kind] : undefined],
  ['Role', p.role],
  ['Tools', p.tools.length ? p.tools.join(', ') : undefined],
].filter(([, v]) => v !== undefined && v !== '');
---

<Base title={`${p.title} — Lautaro Ferrandi`} description={p.summary} image={og.src} current="work">
  <article class="project">
    <div class="wrap">
      <a class="back mono" href={`/#work-${p.section}`}>← {section.label}</a>
      <Label n={index + 1} text={`${section.label} · ${p.category}`} />
      <h1>{p.title}</h1>
      <p class="project__summary">{p.summary}</p>

      <dl class="facts mono">
        {facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>

      <figure class="project__hero">
        {embed ? (
          <div class="embed" style={`--ratio: ${p.videoRatio}`} data-ratio={p.videoRatio}>
            <iframe src={embed} title={`${p.title} — video`} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
          </div>
        ) : p.loop ? (
          <video src={p.loop} autoplay muted loop playsinline aria-label={p.coverAlt}></video>
        ) : (
          <Image src={p.cover} alt={p.coverAlt} widths={[720, 1200, 1600]} sizes="(max-width: 1440px) 92vw, 1300px" loading="eager" />
        )}
      </figure>

      <div class="prose">
        <Content />
      </div>

      {cs && (cs.brief || cs.challenge || cs.idea || cs.process.length > 0) && (
        <section class="case" aria-label="Case study">
          {cs.brief && (
            <div class="case__row">
              <h2 class="case__h mono">Brief</h2>
              <p class="case__text">{cs.brief}</p>
            </div>
          )}
          {cs.challenge && (
            <div class="case__row">
              <h2 class="case__h mono">Challenge</h2>
              <p class="case__text">{cs.challenge}</p>
            </div>
          )}
          {cs.idea && (
            <div class="case__row">
              <h2 class="case__h mono">The idea</h2>
              <p class="case__text case__text--big">{cs.idea}</p>
            </div>
          )}
          {cs.process.length > 0 && (
            <div class="case__row">
              <h2 class="case__h mono">Process</h2>
              <ol class="case__steps">
                {cs.process.map((step, i) => (
                  <li>
                    <span class="case__step-n mono">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </section>
      )}

      {p.blocks.length > 0 && (
        <div class="blocks">
          {p.blocks.map((b) => {
            if (b.type === 'text') {
              return <div class="prose block-text">{b.body.split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}</div>;
            }
            if (b.type === 'image') {
              return (
                <figure class:list={['block-image', { 'is-wide': b.wide }]}>
                  <Image src={b.src} alt={b.alt} widths={[720, 1200, 1800, 2400]} sizes={b.wide ? '100vw' : '(max-width: 1440px) 92vw, 1300px'} />
                  {b.caption && <figcaption class="mono">{b.caption}</figcaption>}
                </figure>
              );
            }
            if (b.type === 'images') {
              return (
                <figure class="block-images" style={`--cols: ${b.items.length}`}>
                  {b.items.map((it) => (
                    <Image src={it.src} alt={it.alt} widths={[480, 720, 1200]} sizes={`(max-width: 700px) 92vw, ${Math.round(92 / b.items.length)}vw`} />
                  ))}
                  {b.caption && <figcaption class="mono">{b.caption}</figcaption>}
                </figure>
              );
            }
            const src = embedUrl(b.url);
            return src ? (
              <figure class="block-video">
                <div class="embed" style={`--ratio: ${b.ratio}`} data-ratio={b.ratio}>
                  <iframe src={src} title={b.title ?? `${p.title} — video`} allow="autoplay; fullscreen; picture-in-picture; xr-spatial-tracking" allowfullscreen loading="lazy"></iframe>
                </div>
                {b.caption && <figcaption class="mono">{b.caption}</figcaption>}
              </figure>
            ) : null;
          })}
        </div>
      )}

      {p.external && (
        <p class="project__external">
          <a class="btn" href={p.external.url} target="_blank" rel="noopener">{p.external.label} ↗</a>
        </p>
      )}

      {cs && (cs.deliverables.length > 0 || cs.results.length > 0 || cs.credits.length > 0) && (
        <section class="case case--end" aria-label="Outcome">
          {cs.results.length > 0 && (
            <div class="case__row">
              <h2 class="case__h mono">Results</h2>
              <ul class="case__results">
                {cs.results.map((r) => (
                  <li><strong>{r.value}</strong><span class="mono">{r.label}</span></li>
                ))}
              </ul>
            </div>
          )}
          {cs.deliverables.length > 0 && (
            <div class="case__row">
              <h2 class="case__h mono">Deliverables</h2>
              <ul class="case__list">{cs.deliverables.map((d) => <li>{d}</li>)}</ul>
            </div>
          )}
          {cs.credits.length > 0 && (
            <div class="case__row">
              <h2 class="case__h mono">Credits</h2>
              <dl class="case__credits">
                {cs.credits.map((c) => (
                  <div><dt class="mono">{c.role}</dt><dd>{c.name}</dd></div>
                ))}
              </dl>
            </div>
          )}
        </section>
      )}

      {next ? (
        <a class="next" href={`/work/${next.id}/`}>
          <p class="label"><span class="tc">Next in {section.label}</span><span>{next.data.category}</span></p>
          <span class="next__title">{next.data.title}&nbsp;→</span>
        </a>
      ) : (
        <a class="next" href={`/#work-${p.section}`}>
          <p class="label"><span class="tc">Back</span><span>{section.label}</span></p>
          <span class="next__title">All {section.label.toLowerCase()} work&nbsp;→</span>
        </a>
      )}
    </div>
  </article>
</Base>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Label from '../components/Label.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FolderDefs from '../components/FolderDefs.astro';
import { getProjects, localize } from '../lib';
import { copy, ui, type Lang } from '../i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const { site, about, work, education, sections } = copy(lang);
const t = ui[lang];

const projects = await Promise.all(
  (await getProjects()).map(async (project) => ({ project, data: (await localize(project, lang)).data })),
);
const groups = sections
  .map((sec) => ({ ...sec, items: projects.filter((p) => p.project.data.section === sec.id) }))
  .filter((g) => g.items.length > 0);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL(lang === 'es' ? '/es/' : '/', Astro.site).href,
  jobTitle: lang === 'es' ? 'Diseñador creativo y multimedia' : 'Creative & Multimedia Designer',
  address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad Nacional de La Plata' },
  sameAs: site.socials.map((s) => s.url),
};
---

<Base lang={lang}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/video/hero-poster.jpg" fetchpriority="high" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </Fragment>
  <Hero lang={lang} />

  <section class="section" id="work" aria-labelledby="work-title" data-fluid>
    <div class="wrap">
      <Label n={1} text={t.selectedWork} />
      <h2 class="section__title" id="work-title">{t.workTitle}</h2>
      <FolderDefs />
      <div class="work-tabs" role="tablist" aria-label={t.kindsOfWork} data-work-tabs hidden>
        {groups.map((g, i) => (
          <button
            class="work-tab"
            type="button"
            role="tab"
            id={`tab-${g.id}`}
            aria-controls={`panel-${g.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={g.id}
          >
            <span class="work-tab__label">{g.label}</span>
            <span class="work-tab__count mono">{String(g.items.length).padStart(2, '0')}</span>
          </button>
        ))}
      </div>
      {groups.map((g, gi) => (
        <div class="work-panel" role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`} data-panel={g.id}>
          <h3 class="work-panel__title">{g.label}</h3>
          <p class="work-panel__blurb mono">{g.blurb}</p>
          <div class="works">
            {g.items.map(({ project, data }, i) => <ProjectCard project={project} data={data} index={i} lang={lang} eager={gi === 0 && i < 3} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <Label n={2} text={t.about} />
      <h2 class="section__title" id="about-title">{t.aboutTitle}</h2>
      <div class="about">
        <p class="about__lead" data-reveal>{about.lead}</p>
        <div class="about__body" data-reveal>
          {about.body.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <div class="timeline-wrap">
        <div class="timeline" data-reveal>
          <h3 class="meta">{t.timelineWork}</h3>
          <ol>
            {work.map((w) => (
              <li>
                <span class="when mono">{w.when}</span>
                <h4>{w.org}</h4>
                <p class="role mono">{w.role}</p>
                <p>{w.text}</p>
              </li>
            ))}
          </ol>
        </div>
        <div class="timeline" data-reveal>
          <h3 class="meta">{t.education}</h3>
          <ol>
            {education.map((w) => (
              <li>
                <span class="when mono">{w.when}</span>
                <h4>{w.org}</h4>
                <p class="role mono">{w.role}</p>
                <p>{w.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <Label n={3} text={t.getInTouch} />
      <h2 class="sr-only" id="contact-title">{t.contact}</h2>
      <a class="contact__big" href={`mailto:${site.email}?subject=${encodeURIComponent(t.mailSubject)}`}>{t.hiThere}</a>
      <div class="contact__row">
        <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="copy-btn mono" type="button" data-copy={site.email} data-copied={t.copied}>{t.copyEmail}</button>
      </div>
    </div>
  </section>
</Base>
